# Copy to .env and fill locally. Never commit .env.
# Scope: Termix track only. Do not wire BNB Agent Studio / x402.

# --- Chain (BSC only) ---
BSC_RPC_URL=https://bsc-rpc.publicnode.com
# Optional extra RPC for reads
BSC_RPC_FALLBACK_URL=

# --- Agent wallet (Termix escrow side ONLY — never used for user DeFi) ---
# Required only for live Termix mint / accept / deliver / A2A login.
WALLET_KEY=

# --- Buyer wallet (e2e hire / checkout ONLY — must differ from WALLET_KEY) ---
# Needs BNB for gas and at least LISTING_BASE_PRICE USDC on BSC.
BUYER_WALLET_KEY=
# Optional: set after the e2e script mints the buyer's agent NFT
TERMIX_BUYER_AGENT_ID=
# Published bStocks listing (custom-offer path; instantBuyable=false)
TERMIX_LISTING_ID=cmtdjaletb3yftg012bh5xma2

# --- Termix AACP (BNB Chain) ---
# Do not hardcode Termix contract addresses; they are fetched from GET /api/v1/config/contracts
AACP_API=https://platform-backend.prod.termix.live
AACP_CHAIN=bsc
TERMIX_AGENT_ID=
TERMIX_AGENT_HANDLE=bStocks

# --- LLM (default: DeepSeek OpenAI-compatible) ---
# https://api-docs.deepseek.com/  key: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# deepseek-v4-flash (default, cheaper) or deepseek-v4-pro
A2A_LLM_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
# Optional fallbacks if DEEPSEEK_API_KEY is empty
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Runtime HTTP (intent store + signer callback) ---
RUNTIME_PORT=8787
RUNTIME_PUBLIC_URL=http://127.0.0.1:8787
# Production signer (Vercel). Local override: http://127.0.0.1:3000
SIGNER_WEB_URL=https://signer-web-phi.vercel.app
A2A_POLL_INTERVAL_MS=5000
INTENT_TTL_MS=180000
DATA_DIR=.data

# --- Signer web ---
NEXT_PUBLIC_RUNTIME_URL=http://127.0.0.1:8787
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=56

# --- Risk / ops ---
# Comma-separated ISO country codes treated as restricted (default includes US)
RESTRICTED_GEOS=US
# Listing quote in display units (not raw). Live listing is 0.01 USDC.
# Termix default settlement is USDC; DeFi pool quotes can still be USDT.
LISTING_BASE_PRICE=0.01
LISTING_CURRENCY=USDC
LISTING_DELIVERY_DAYS=3
